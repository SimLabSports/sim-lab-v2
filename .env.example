# Configure these locally or in the deployment secret manager. Never use NEXT_PUBLIC_ for secrets.
ODDS_API_KEY=
# BALLDONTLIE key shared across sport endpoints; subscriptions are verified per sport.
BALLDONTLIE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=
# Optional project identity guard. Copy the reference from the NEW Sim Lab 2.0 project settings.
# A configured mismatch blocks database operations; never guess this identifier.
SUPABASE_EXPECTED_PROJECT_REF=
# Generate a private random token of at least 32 characters for administrator sign-in.
SIMLAB_ADMIN_TOKEN=
# Optional licensed statistics expansion beyond the public MLB adapter.
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_NFL_KEY=
SPORTSDATAIO_NBA_KEY=
SPORTSDATAIO_NHL_KEY=
SPORTSDATAIO_MLB_KEY=
# Explicit user scans run research; passive page reads never make billable AI calls.
GCM_MAX_AGE_MINUTES=15
GCM_SCAN_HOURLY_LIMIT=20
GCM_SCAN_DAILY_LIMIT=50
GCM_SCAN_VISITOR_HOURLY_LIMIT=5
EXPERT_MAX_AGE_HOURS=48
GCM_PRICE_MIN=-250
GCM_PRICE_MAX=-120
GCM_SAFE_MIN_PROBABILITY=70
GCM_MIN_EDGE_PP=2
# Set only after your SportsDataIO subscription is verified as real, non-scrambled data.
SPORTSDATAIO_REAL_DATA_CONFIRMED=false
